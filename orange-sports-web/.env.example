# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋되지 않음)

# DeepL API Free 인증키 (https://www.deepl.com/pro-api → Sign up for free → API Keys)
# Free 키는 보통 "...:fx" 로 끝난다. 없으면 번역은 MyMemory 폴백 → 영어 원문 순으로 동작.
DEEPL_API_KEY=

# (선택) 서버 포트. 기본 4173
# ORANGE_SPORTS_PORT=4173

# (선택) 영구 데이터 디렉터리. 기본은 ./.cache
# DATA_DIR=./.cache
