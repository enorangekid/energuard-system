{
  "name": "orange-sports",
  "version": "2.6.0",
  "description": "NBA, MLB, EPL, UCL, F1 데이터와 실시간 알림을 제공하는 Orange Sports Windows 클라이언트",
  "main": "main.js",
  "author": "Orange Sports",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check notification-preload.js && node --check notification.js",
    "build": "electron-builder --win nsis --config.electronDist=node_modules/electron/dist --config.directories.output=final-release",
    "build:portable": "electron-builder --win portable --config.electronDist=node_modules/electron/dist --config.directories.output=final-release"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.energuard.nbalivewidget",
    "productName": "Orange Sports",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "notification-preload.js",
      "notification.html",
      "notification.css",
      "notification.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon-build.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Orange-Sports-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orange Sports"
    }
  }
}
