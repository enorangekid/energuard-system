{
  "manifest_version": 3,
  "name": "에너가드 가격검사 테스트",
  "version": "0.30.9",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://smartstore.naver.com/*",
    "https://boonimall.kr/*",
    "https://item.gmarket.co.kr/*",
    "https://itempage3.auction.co.kr/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smartstore.naver.com/*"
      ],
      "js": [
        "smartstore-network-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://smartstore.naver.com/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boonimall.kr/goods/view*"
      ],
      "js": [
        "boonimall-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://item.gmarket.co.kr/Item*",
        "https://itempage3.auction.co.kr/DetailView.aspx*"
      ],
      "js": [
        "esm-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://enorangekid.github.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
